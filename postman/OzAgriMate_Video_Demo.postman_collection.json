    {
     "name": "08 GET /telemetry - owner lists readings (200)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer demo-owner-a"
       }
      ],
      "url": "{{telemetryUrl}}/farms/farm-001/telemetry?metric=soilMoisture&deviceId=sm-north-01"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Three seeded + one new accepted reading, in time order\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"farmId\",\"count\",\"hasMore\",\"readings\"); pm.expect(v.count).to.eql(4); pm.expect(v.hasMore).to.eql(false); pm.expect(v.readings.map(r=>r.value)).to.eql([31.2,30.8,30.1,29.7]); pm.expect(v.readings.every(r=>r.status===\"ACCEPTED\")).to.eql(true); });"
        ]
       }
      }
     ]
    },
    {
     "name": "09 GET /telemetry - other owner denied (404)",
