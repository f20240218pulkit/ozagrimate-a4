         "if (pm.response.code === 201) { pm.collectionVariables.set(\"requestId\", pm.response.json().id); }",
         "pm.test(\"Created as PENDING with server-assigned fields\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"id\",\"farmId\",\"paddockId\",\"scheduledStart\",\"durationMinutes\",\"waterDepthMm\",\"notes\",\"status\",\"requestedBy\",\"version\"); pm.expect(v.status).to.eql(\"PENDING\"); pm.expect(v.requestedBy).to.eql(\"worker-a\"); pm.expect(v.version).to.eql(1); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/farms/farm-001/irrigation-requests/\"+v.id); });"
        ]
       }
      }
