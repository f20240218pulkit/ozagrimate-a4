{
 "info": {
  "name": "OzAgriMate - Video Demo (all 8 endpoints)",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Start everything fresh with `py -3 run_all.py`, then run in order. Covers all eight endpoints with a success case and relevant error cases each."
 },
 "variable": [
  {
   "key": "farmUrl",
   "value": "http://127.0.0.1:8001"
  },
  {
   "key": "telemetryUrl",
   "value": "http://127.0.0.1:8002"
  },
  {
   "key": "irrigationAlertsUrl",
   "value": "http://127.0.0.1:8003"
  },
  {
   "key": "farmId",
   "value": ""
  },
  {
   "key": "createdFarm",
   "value": ""
  },
  {
   "key": "firstReceivedAt",
   "value": ""
  },
  {
   "key": "requestId",
   "value": ""
  },
  {
   "key": "ruleId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Farm Management - port 8001",
   "item": [
    {
     "name": "01 POST /farms - create farm (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-owner-a"
       }
      ],
      "url": "{{farmUrl}}/farms",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Riverbend Farm\",\n  \"latitude\": -36.36,\n  \"longitude\": 145.4,\n  \"areaHectares\": 125.5\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "if (pm.response.code === 201) { pm.collectionVariables.set(\"farmId\", pm.response.json().id); pm.collectionVariables.set(\"createdFarm\", JSON.stringify(pm.response.json())); }",
         "pm.test(\"Creation contract\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"id\",\"name\",\"latitude\",\"longitude\",\"areaHectares\"); pm.expect(v.name).to.eql(\"Riverbend Farm\"); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/farms/\"+v.id); });"
        ]
       }
      }
     ]
    },
    {
     "name": "02 GET /farms/{farmId} - retrieve farm (200)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-owner-a"
       }
      ],
      "url": "{{farmUrl}}/farms/{{farmId}}"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Retrieved record matches creation\", function () { pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get(\"createdFarm\"))); });"
        ]
       }
      }
     ]
    },
    {
     "name": "03 GET /farms/{farmId} - other owner denied (404)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-owner-b"
       }
      ],
      "url": "{{farmUrl}}/farms/{{farmId}}"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"FARM_NOT_FOUND\"); });"
        ]
       }
      }
     ]
    },
    {
     "name": "04 POST /farms - worker cannot create (403)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-worker-a"
       }
      ],
      "url": "{{farmUrl}}/farms",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Riverbend Farm\",\n  \"latitude\": -36.36,\n  \"longitude\": 145.4,\n  \"areaHectares\": 125.5\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\"); });"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "Telemetry - port 8002",
   "item": [
    {
     "name": "05 POST /telemetry - gateway submits reading (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-gateway-001"
       }
      ],
      "url": "{{telemetryUrl}}/farms/farm-001/telemetry",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"schemaVersion\": 1,\n  \"readingId\": \"sm-north-01-20261023T2045Z\",\n  \"deviceId\": \"sm-north-01\",\n  \"paddockId\": \"north-paddock\",\n  \"metric\": \"soilMoisture\",\n  \"value\": 29.7,\n  \"unit\": \"%\",\n  \"observedAt\": \"2026-10-23T20:45:00Z\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Reading stored as ACCEPTED with exact contract\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"readingId\",\"farmId\",\"deviceId\",\"paddockId\",\"metric\",\"value\",\"unit\",\"observedAt\",\"receivedAt\",\"status\",\"quarantineReasons\",\"schemaVersion\"); pm.expect(v.status).to.eql(\"ACCEPTED\"); pm.expect(v.quarantineReasons).to.eql([]); pm.expect(v.farmId).to.eql(\"farm-001\"); pm.expect(v.value).to.eql(29.7); pm.collectionVariables.set(\"firstReceivedAt\", v.receivedAt); });"
        ]
       }
      }
     ]
    },
    {
     "name": "06 POST /telemetry - spike quarantined (201)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer demo-gateway-001"
       }
      ],
      "url": "{{telemetryUrl}}/farms/farm-001/telemetry",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"schemaVersion\": 1,\n  \"readingId\": \"sm-north-01-20261023T2100Z\",\n  \"deviceId\": \"sm-north-01\",\n  \"paddockId\": \"north-paddock\",\n  \"metric\": \"soilMoisture\",\n  \"value\": 88.0,\n  \"unit\": \"%\",\n  \"observedAt\": \"2026-10-23T21:00:00Z\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
         "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
         "pm.test(\"Stored as QUARANTINED with reason\", function () { const v=pm.response.json(); pm.expect(v.status).to.eql(\"QUARANTINED\"); pm.expect(v.quarantineReasons).to.eql([\"SPIKE_DETECTED\"]); });"
        ]
       }
      }
     ]
    },
    {
     "name": "07 POST /telemetry - out-of-range value (422)",
     "request": {
      "method": "POST",
      "header": [
