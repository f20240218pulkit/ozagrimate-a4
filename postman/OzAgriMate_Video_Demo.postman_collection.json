       "raw": "{\n  \"paddockId\": \"north-paddock\",\n  \"scheduledStart\": \"2026-11-02T19:00:00Z\",\n  \"durationMinutes\": 90,\n  \"waterDepthMm\": 18.5,\n  \"notes\": \"Pre-heatwave watering\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
