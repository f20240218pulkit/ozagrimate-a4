{
 "info": {
  "name": "Aditya - OzAgriMate Telemetry",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Run in order, one iteration, against a freshly started Telemetry service (python -m services.telemetry.app, port 8002). Seeded readings exist on farm-001 and farm-002. Tokens are local demonstration identities, not production authentication. No broker is deployed; accepted-reading events go to an in-memory outbox."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://127.0.0.1:8002"
  },
  {
   "key": "firstReceivedAt",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "01 Submit soil-moisture reading - gateway 001",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer demo-gateway-001"
     }
    ],
    "url": "{{baseUrl}}/farms/farm-001/telemetry",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"schemaVersion\": 1,\n  \"readingId\": \"sm-north-01-20261023T2045Z\",\n  \"deviceId\": \"sm-north-01\",\n  \"paddockId\": \"north-paddock\",\n  \"metric\": \"soilMoisture\",\n  \"value\": 29.7,\n  \"unit\": \"%\",\n  \"observedAt\": \"2026-10-23T20:45:00Z\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
       "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
       "pm.test(\"Reading stored as ACCEPTED with exact contract\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"readingId\",\"farmId\",\"deviceId\",\"paddockId\",\"metric\",\"value\",\"unit\",\"observedAt\",\"receivedAt\",\"status\",\"quarantineReasons\",\"schemaVersion\"); pm.expect(v.status).to.eql(\"ACCEPTED\"); pm.expect(v.quarantineReasons).to.eql([]); pm.expect(v.farmId).to.eql(\"farm-001\"); pm.expect(v.value).to.eql(29.7); pm.collectionVariables.set(\"firstReceivedAt\", v.receivedAt); });"
      ]
     }
    }
   ]
  },
  {
   "name": "02 Replay identical reading (edge buffer resend) - idempotent",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer demo-gateway-001"
     }
    ],
    "url": "{{baseUrl}}/farms/farm-001/telemetry",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"schemaVersion\": 1,\n  \"readingId\": \"sm-north-01-20261023T2045Z\",\n  \"deviceId\": \"sm-north-01\",\n  \"paddockId\": \"north-paddock\",\n  \"metric\": \"soilMoisture\",\n  \"value\": 29.7,\n  \"unit\": \"%\",\n  \"observedAt\": \"2026-10-23T20:45:00Z\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
       "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
       "pm.test(\"Original record returned, no duplicate created\", function () { const v=pm.response.json(); pm.expect(v.readingId).to.eql(\"sm-north-01-20261023T2045Z\"); pm.expect(v.receivedAt).to.eql(pm.collectionVariables.get(\"firstReceivedAt\")); });"
      ]
     }
    }
   ]
  },
  {
