       "pm.test(\"Three seeded + one new accepted reading, in time order\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"farmId\",\"count\",\"hasMore\",\"readings\"); pm.expect(v.count).to.eql(4); pm.expect(v.hasMore).to.eql(false); pm.expect(v.readings.map(r=>r.value)).to.eql([31.2,30.8,30.1,29.7]); pm.expect(v.readings.every(r=>r.status===\"ACCEPTED\")).to.eql(true); });"
