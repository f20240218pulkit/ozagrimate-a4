          "mode": "raw",
          "raw": "{\n  \"name\": \"Riverbend Farm\",\n  \"latitude\": -36.36,\n  \"longitude\": 145.4,\n  \"areaHectares\": 125.5,\n  \"ownerUserId\": \"owner-b\"\n}",
          "options": {
