              "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Missing authentication on retrieval",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/farms/{{farmId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Worker cannot create farm",
