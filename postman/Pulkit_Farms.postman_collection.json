              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"); });"
            ]
          }
