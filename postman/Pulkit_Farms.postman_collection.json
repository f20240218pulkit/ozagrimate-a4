    },
    {
      "name": "11 Incorrect media type rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          },
          {
            "key": "Authorization",
            "value": "Bearer demo-owner-a"
