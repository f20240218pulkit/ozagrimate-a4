              "pm.test(\"Error code\", function () { pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Caller cannot assign ownership",
      "request": {
