{
 "info": {
  "name": "Bradley - OzAgriMate Alert Rules",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Run in order against a freshly started Irrigation and Alerts service (port 8003). Only farm owners manage alert rules. A rule's sensorId matches the telemetry reading's deviceId, and units follow the telemetry catalogue: soilMoisture %, soilTemperature and airTemperature degC, rainfall mm. Fixture tokens are demonstration identities."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://127.0.0.1:8003"
  },
  {
   "key": "ruleId",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "01 Create critical soil-moisture rule - owner A",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer demo-owner-a"
     }
    ],
    "url": "{{baseUrl}}/farms/farm-001/alert-rules",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Dry north paddock\",\n  \"sensorId\": \"sm-north-01\",\n  \"metric\": \"soilMoisture\",\n  \"operator\": \"<\",\n  \"threshold\": 20,\n  \"unit\": \"%\",\n  \"severity\": \"critical\",\n  \"reminderMinutes\": 30\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
       "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
       "if (pm.response.code === 201) { pm.collectionVariables.set(\"ruleId\", pm.response.json().ruleId); }",
       "pm.test(\"Rule stored with server-assigned id\", function () { const v=pm.response.json(); pm.expect(v).to.have.all.keys(\"name\",\"sensorId\",\"metric\",\"operator\",\"threshold\",\"unit\",\"severity\",\"reminderMinutes\",\"ruleId\",\"farmId\"); pm.expect(v.farmId).to.eql(\"farm-001\"); pm.expect(v.severity).to.eql(\"critical\"); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/farms/farm-001/alert-rules/\"+v.ruleId); });"
      ]
     }
    }
   ]
  },
  {
   "name": "02 Create air-temperature rule (trimmed name, no reminder)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer demo-owner-a"
     }
    ],
    "url": "{{baseUrl}}/farms/farm-001/alert-rules",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"  Hot afternoon  \",\n  \"sensorId\": \"wx-01\",\n  \"metric\": \"airTemperature\",\n  \"operator\": \">\",\n  \"threshold\": 38,\n  \"unit\": \"degC\",\n  \"severity\": \"warning\",\n  \"reminderMinutes\": null\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
       "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
       "pm.test(\"Name trimmed, reminder null\", function () { const v=pm.response.json(); pm.expect(v.name).to.eql(\"Hot afternoon\"); pm.expect(v.reminderMinutes).to.eql(null); });"
      ]
     }
    }
   ]
  },
  {
   "name": "03 Reject soilMoisture in 'percent' (unit must be %)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     },
     {
      "key": "Authorization",
      "value": "Bearer demo-owner-a"
     }
    ],
    "url": "{{baseUrl}}/farms/farm-001/alert-rules",
    "body": {
     "mode": "raw",
     "raw": "{\n  \"name\": \"Dry north paddock\",\n  \"sensorId\": \"sm-north-01\",\n  \"metric\": \"soilMoisture\",\n  \"operator\": \"<\",\n  \"threshold\": 20,\n  \"unit\": \"percent\",\n  \"severity\": \"critical\",\n  \"reminderMinutes\": 30\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    },
    "description": "Owner submits a rule using the wrong unit, percent.\nExpected response: 422 VALIDATION_ERROR."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
       "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
       "pm.test(\"Error code VALIDATION_ERROR\", function () { pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"); });"
      ]
     }
    }
   ]
  },
